# Copy to .env for local development. .env is gitignored.
#
# When running `npm run dev` directly on the host (not via docker compose),
# the frontend isn't on the Docker network, so it can't reach the IPFS admin
# API at its container hostname (ipfs-node:5001). Point it at the API's
# host-published port instead.
IPFS_API_URL=http://localhost:5001

# Public gateway + DNSLink domain. Read server-side only (in the vault-status
# loader) and rendered into the page, so no VITE_ prefix needed. Locally,
# point this at the gateway port docker-compose publishes on the host so
# links to your local-only content actually resolve (the production
# domain's gateway won't have it).
IPFS_GATEWAY_URL=http://localhost:8080
DNSLINK_DOMAIN=keepthereceipts.net

# The app's own public URL, used to build absolute links back to itself
# (canonical link / og:url tags) — unrelated to IPFS. localhost:3000 in
# local dev, the real domain in production.
BASE_URL=http://localhost:3000

# Path to a Chromium/Chrome binary, used by playwright-core to capture a
# screenshot + offline MHTML archive when a document has a source URL. The
# Docker image installs Alpine's `chromium` package and sets this for you
# (see Dockerfile.frontend). For local `npm run dev`, point it at a Chrome
# install if you want to test capture; leave unset and capture just fails
# gracefully (screenshot/archive status become "failed", nothing else breaks).
# CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

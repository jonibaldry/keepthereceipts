# Copy to .env for local development. .env is gitignored.
#
# When running `npm run dev` directly on the host (not via docker compose),
# the frontend isn't on the Docker network, so it can't reach the IPFS admin
# API at its container hostname (ipfs-node:5001). Point it at the API's
# host-published port instead.
IPFS_API_URL=http://localhost:5001

# Public gateway + DNSLink domain. Read server-side only (in the vault-status
# loader) and rendered into the page, so no VITE_ prefix needed.
IPFS_GATEWAY_URL=https://ipfs.keepthereceipts.net
DNSLINK_DOMAIN=keepthereceipts.net

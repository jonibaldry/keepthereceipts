# Copy to .env and fill in real values. .env is gitignored.

# deSEC API token (Settings -> Tokens in your deSEC account)
DESEC_TOKEN=

# The zone in your deSEC account that the DNSLink TXT record lives under,
# e.g. example.com
DESEC_DOMAIN=

# Record name within the zone. Leave as _dnslink to publish DNSLink for the
# apex domain; use e.g. _dnslink.vault for a subdomain.
# DESEC_SUBNAME=_dnslink

# DESEC_TTL=3600

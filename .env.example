# Copy to .env and fill in real values. .env is gitignored.

# Signing key for session JWTs (frontend/src/server/session.server.ts).
# Required — the app refuses to start without it. Generate one with:
#   openssl rand -base64 32
# Anyone with this value can forge a valid session for any user, so treat it
# like any other credential: never commit it, rotate it if it ever leaks
# (which invalidates every existing session).
JWT_SECRET=

# deSEC API token (Settings -> Tokens in your deSEC account)
DESEC_TOKEN=

# The zone in your deSEC account that the DNSLink TXT record lives under,
# e.g. example.com
DESEC_DOMAIN=

# Record name within the zone. Leave as _dnslink to publish DNSLink for the
# apex domain; use e.g. _dnslink.vault for a subdomain.
# DESEC_SUBNAME=_dnslink

# DESEC_TTL=3600
